UtilTab:CreateToggle({ Name="Low Graphics (disable particles + smoke)", CurrentValue=false, Flag="LowGraphics", Callback=function(v) for _, o in ipairs(Workspace:GetDescendants()) do if o:IsA("ParticleEmitter") or o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") then pcall(function() o.Enabled = not v end) end end end }) 

