-- 10. MULTICOLOR ESP (clean, no lag)
local ESPGui = nil
local espCache = {}

local function setupESP()
    if ESPGui then ESPGui:Destroy() end
    ESPGui = Instance.new("ScreenGui")
    ESPGui.Name = "FTAP_Ultimate_ESP"
    ESPGui.ResetOnSpawn = false
    ESPGui.Parent = CoreGui
end

local function clearESP()
    for obj, highlight in pairs(espCache) do
        pcall(function() highlight:Destroy() end)
    end
    espCache = {}
end

local function isPlayerDowned(plr)
    if not plr.Character then return false end
    local hum = plr.Character:FindFirstChildWhichIsA("Humanoid")
    return hum and (hum.Health <= 0 or plr.Character:FindFirstChild("Downed"))
end

local function updateESP()
    if not flags.espPlayers then clearESP(); return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local highlight = espCache[plr]
            if not highlight then
                highlight = Instance.new("Highlight", plr.Character)
                highlight.Name = "_FTAP_ESP"
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.FillTransparency = 0.4
                highlight.OutlineTransparency = 0
                espCache[plr] = highlight
            end
            local isDown = isPlayerDowned(plr)
            highlight.FillColor = isDown and Color3.fromRGB(255, 0, 0) or settings.espColor
            highlight.OutlineColor = isDown and Color3.fromRGB(255, 100, 100) or settings.espOutline
        else
            if espCache[plr] then
                pcall(function() espCache[plr]:Destroy() end)
                espCache[plr] = nil
            end
        end
    end
end

task.spawn(function()
    setupESP()
    while task.wait(0.5) do
        pcall(updateESP)
    end
end)

-- 11. REMOTE SPY (for debugging)
local remoteLogs = {}
local function logRemote(name, args)
    local argStr = ""
    for i, v in ipairs(args or {}) do argStr = argStr .. tostring(v) .. " " end
    table.insert(remoteLogs, "[" .. os.date("%H:%M:%S") .. "] " .. name .. ": " .. argStr)
    print("[Remote] " .. name .. ": " .. argStr)
end

local function setupRemoteSpy()
    local mt = getrawmetatable(game)
    if mt then
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self:IsA("RemoteEvent") and flags.remoteSpy then
                logRemote(self.Name, {...})
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
        notify("Remote Spy", "Active – logs in console", 3)
    end
end

