local espCache = {} 
local function ClearESP() 
    for _, h in pairs(espCache) do 
        pcall(function() h:Destroy() end) 
    end 
    espCache = {} 
end 
local function AddHighlight(obj, fill, outline, label) 
    if not obj then return end 
    -- Remove old 
    local old = obj:FindFirstChild("_H_NMT") 
    if old then old:Destroy() end 
    local h = Instance.new("Highlight", obj) 
    h.Name = "_H_NMT" 
    h.FillColor = fill 
    h.OutlineColor = outline or Color3.fromRGB(255,255,255) 
    h.FillTransparency = 0.45 
    h.OutlineTransparency = 0 
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop 
    table.insert(espCache, h) 
    if label then 
        local bb = Instance.new("BillboardGui", obj) 
        bb.Name = "_BB_NMT" 
        bb.Size = UDim2.new(0,180,0,44) 
        bb.StudsOffset = Vector3.new(0,4,0) 
        bb.AlwaysOnTop = true 
        bb.LightInfluence = 0 
        table.insert(espCache, bb) 
        local lbl = Instance.new("TextLabel", bb) 
        lbl.Size = UDim2.new(1,0,1,0) 
        lbl.BackgroundTransparency = 1 
        lbl.Text = label 
        lbl.TextColor3 = fill 
        lbl.Font = Enum.Font.GothamBold 
        lbl.TextScaled = true 
    end 
end 
local espTimer = 0 
RunService.Heartbeat:Connect(function(dt) 
    espTimer = espTimer + dt 
    if espTimer < 1.5 then return end 
    espTimer = 0 
    if not espEnabled and not espExitEnabled and not espCorruptEnabled then ClearESP(); return end 
    ClearESP() 
    local myHRP = GetHRP() 
    if espEnabled then 
        for _, plr in ipairs(Players:GetPlayers()) do 
            if plr ~= LocalPlayer and plr.Character then 
                local h = plr.Character:FindFirstChild("HumanoidRootPart") 
                if h then 
                    local dist = myHRP and math.floor((h.Position - myHRP.Position).Magnitude) or 0 
                    AddHighlight(plr.Character, Color3.fromRGB(80,200,255), Color3.fromRGB(255,255,255), plr.Name .. " " .. dist .. " st") 
                end 
            end 
        end 
    end 
    if espExitEnabled then 
        for _, v in ipairs(Workspace:GetDescendants()) do 
            local n = v.Name:lower() 
            if v:IsA("BasePart") and (n:find("exit") or n:find("goal") or n:find("finish") or n:find("portal")) then 
                AddHighlight(v, Color3.fromRGB(50,255,100), Color3.fromRGB(0,255,80), "EXIT") 
            end 
        end 
    end 
    if espCorruptEnabled then 
        for _, v in ipairs(Workspace:GetDescendants()) do 
            local n = v.Name:lower() 
            if v:IsA("BasePart") and (n:find("corrupt") or n:find("deathwall")) and (v.Size.X > 40 or v.Size.Z > 40) then 
                local myPos = myHRP and myHRP.Position or Vector3.zero 
                local dist = math.floor((v.Position - myPos).Magnitude) 
                AddHighlight(v, Color3.fromRGB(255,50,50), Color3.fromRGB(255,100,100), "WALL " .. dist .. " st") 
            end 
        end 
    end 
end) 

