-- NOCLIP — FIXED 
-- 
-- Old: Set CanCollide=false in Heartbeat (after physics = too late). 
-- Fixed: Use Stepped (pre-physics) so it applies before collision 
-- is resolved. Also covers all descendant BaseParts each frame. 
-- ══════════════════════════════════════════════════════════ 
RunService.Stepped:Connect(function() 
