-- FLY — FIXED 
-- 
-- Old: BodyVelocity alone causes jitter and fight with physics. 
-- Fixed: Use AlignPosition + AlignOrientation (modern API, no jitter) 
-- with very high MaxForce. Falls back to BodyVelocity if not available. 
-- ══════════════════════════════════════════════════════════ 
local flyAttach0 = nil 
local flyAttach1 = nil 
local flyAlignPos = nil 
local flyAlignOrient = nil 
local flyTargetCF = nil 
local function CleanFly() 
    DC("fly") 
    if flyAttach0 then flyAttach0:Destroy(); flyAttach0 = nil end 
    if flyAttach1 then flyAttach1:Destroy(); flyAttach1 = nil end 
    if flyAlignPos then flyAlignPos:Destroy(); flyAlignPos = nil end 
    if flyAlignOrient then flyAlignOrient:Destroy(); flyAlignOrient= nil end 
    flyTargetCF = nil 
end 
local function StartFly() 
    CleanFly() 
    local hrp = GetHRP(); if not hrp then return end 
    flyTargetCF = hrp.CFrame 
    -- Two attachments: one on HRP, one in Workspace (world-space anchor) 
    flyAttach0 = Instance.new("Attachment", hrp) 
    flyAttach0.Name = "_FlyA0" 
    flyAttach1 = Instance.new("Attachment", Workspace.Terrain) 
    flyAttach1.Name = "_FlyA1" 
    flyAttach1.WorldPosition = hrp.Position 
    -- AlignPosition: drives HRP to flyTargetCF.Position 
    flyAlignPos = Instance.new("AlignPosition", hrp) 
    flyAlignPos.Attachment0 = flyAttach0 
    flyAlignPos.Attachment1 = flyAttach1 
    flyAlignPos.MaxForce = 1e6 
    flyAlignPos.MaxVelocity = math.huge 
    flyAlignPos.Responsiveness = 200 
    flyAlignPos.RigidityEnabled = false 
    flyAlignPos.ApplyAtCenterOfMass = true 
    -- AlignOrientation: keeps the camera facing direction 
    flyAlignOrient = Instance.new("AlignOrientation", hrp) 
    flyAlignOrient.Attachment0 = flyAttach0 
    flyAlignOrient.Attachment1 = flyAttach1 
    flyAlignOrient.MaxTorque = 1e6 
    flyAlignOrient.MaxAngularVelocity = math.huge 
    flyAlignOrient.Responsiveness = 200 
    flyAlignOrient.PrimaryAxisOnly = false 
    DC("fly") 
    connections.fly = RunService.Stepped:Connect(function() 
        if not flyEnabled then CleanFly(); return end 
        local hrp2 = GetHRP(); if not hrp2 then return end 
        if not flyAttach1 then return end 
        -- Build direction from keys 
        local cf = Camera.CFrame 
        local up = Vector3.new(0,1,0) 
        local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z) 
        local rt = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z) 
        fwd = fwd.Magnitude > 0.01 and fwd.Unit or Vector3.zero 
        rt = rt.Magnitude > 0.01 and rt.Unit or Vector3.zero 
        local dir = Vector3.zero 
        if not UserInputService:GetFocusedTextBox() then 
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd end 
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd end 
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - rt end 
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + rt end 
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + up end 
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then dir = dir - up end 
        end 
        -- Smooth target position 
        if dir.Magnitude > 0.01 then 
            flyTargetCF = flyTargetCF * CFrame.new(dir.Unit * flySpeed * 0.05) 
        end 
        -- Drive the anchor attachment to target 
        flyAttach1.WorldPosition = flyTargetCF.Position 
        flyAlignOrient.CFrame = cf -- face camera direction 
        -- Keep humanoid from fighting fly 
        local hum = GetHum() 
        if hum then hum.PlatformStand = true end 
        hrp2.AssemblyLinearVelocity = Vector3.zero 
        hrp2.AssemblyAngularVelocity = Vector3.zero 
    end) 
end 
local function StopFly() 
    CleanFly() 
    local hum = GetHum() 
    if hum then hum.PlatformStand = false end 
end 
