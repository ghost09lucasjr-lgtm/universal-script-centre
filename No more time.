-- ======================== AUTO WIN ======================== 
local function DoAutoWin() 
    local hrp = GetHRP(); if not hrp then Notify("Auto Win","No character.") return end 
    local exit = FindByNames({"Exit","Goal","End","Finish","Portal","Escape","Complete"}) 
    if exit then 
        local pos = exit:IsA("BasePart") and exit.Position or exit:GetPivot().Position 
        hrp.CFrame = CFrame.new(pos + Vector3.new(0,5,0)) 
        Notify("Auto Win", "Teleported to " .. exit.Name .. "!", 4) 
        return 
    end 
    for _, name in ipairs({"CompleteRound","FinishRound","WinRound","RoundComplete","Complete"}) do 
        local r = ReplicatedStorage:FindFirstChild(name, true) 
        if r and r:IsA("RemoteEvent") then 
            r:FireServer(); Notify("Auto Win","Fired remote: "..name, 4); return 
        end 
    end 
    Notify("Auto Win","Exit not found — use Debug to locate part names.", 4) 
end 
RunService.Heartbeat:Connect(function() 
    if not autoWinEnabled then return end 
    DoAutoWin(); autoWinEnabled = false 
end) 

