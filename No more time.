-- 2. FLING MECHANICS
local function getNearestPlayer()
    local myHRP = getHRP()
    if not myHRP then return nil end
    local nearest, minDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < minDist then
                    minDist, nearest = dist, plr
                end
            end
        end
    end
    return nearest, minDist
end

local function flingPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Method 1: ApplyImpulse (most reliable)
    hrp:ApplyImpulse(Vector3.new(0, settings.flingPower, 0))
    
    -- Method 2: AssemblyLinearVelocity (backup)
    hrp.AssemblyLinearVelocity = Vector3.new(0, settings.flingPower * 1.5, 0)
    
    -- Method 3: If physics remote exists, fire it
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local physics = remotes and remotes:FindFirstChild("Physics")
    if physics and physics.ApplyImpulse then
        pcall(physics.ApplyImpulse.FireServer, physics.ApplyImpulse, Vector3.new(0, settings.flingPower * 2, 0))
    end
    
    print("[FTAP] Flinged:", targetPlayer.Name, "Power:", settings.flingPower)
    notify("Fling", targetPlayer.Name .. " flung!", 2)
    return true
end

local function flingNearest()
    local target, dist = getNearestPlayer()
    if target then
        flingPlayer(target)
    else
        notify("Fling", "No nearby players found", 2)
    end
end

