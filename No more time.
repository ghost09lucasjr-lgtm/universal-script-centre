-- ════ UTILITY ════════════════════════════════════════════ 
UtilTab:CreateSection("Character") 
UtilTab:CreateButton({ Name="Full Heal", Callback=function() local h=GetHum(); if h then h.Health=h.MaxHealth; Notify("Heal","HP restored!") end end }) 
UtilTab:CreateButton({ Name="Respawn", Callback=function() local h=GetHum(); if h then h.Health=0; Notify("Respawn","Respawning...") end end }) 
UtilTab:CreateSection("World") 
