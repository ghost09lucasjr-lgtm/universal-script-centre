-- SPEED — FIXED 
-- 
-- Old: Just set WalkSpeed in Heartbeat. 
-- Fixed: Set in Stepped (pre-physics), also set WalkSpeed + use 
-- AssemblyLinearVelocity boost to overcome the game's movement cap. 
-- ══════════════════════════════════════════════════════════ 
RunService.Stepped:Connect(function() 
    if not speedEnabled then return end 
    local hum = GetHum(); local hrp = GetHRP() 
    if not hum or not hrp then return end 
    -- Set WalkSpeed pre-physics so the engine uses it this frame 
    hum.WalkSpeed = walkspeedValue 
    -- If the player is pressing movement keys, also nudge velocity 
    -- This overcomes server-side WalkSpeed caps in some games 
    if not UserInputService:GetFocusedTextBox() then 
        local movDir = Vector3.zero 
        local cf = Camera.CFrame 
        local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z) 
        local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z) 
        if fwd.Magnitude > 0.01 then fwd = fwd.Unit end 
        if right.Magnitude > 0.01 then right = right.Unit end 
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then movDir = movDir + fwd end 
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then movDir = movDir - fwd end 
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then movDir = movDir - right end 
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then movDir = movDir + right end 
        if movDir.Magnitude > 0.01 then 
            local vel = hrp.AssemblyLinearVelocity 
            local targetH = movDir.Unit * walkspeedValue 
            -- Lerp current horizontal velocity toward target — avoids sudden jump 
            local newH = Vector3.new(vel.X, 0, vel.Z):Lerp(targetH, 0.35) 
            hrp.AssemblyLinearVelocity = Vector3.new(newH.X, vel.Y, newH.Z) 
        end 
    end 
end) 

