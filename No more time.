-- GODMODE — FIXED 
-- 
-- Old method (only Heartbeat Health reset) fails because: 
-- • TakeDamage is processed before Heartbeat runs 
-- • Server can override health directly 
-- 
-- New method (layered): 
-- 1. Hook __newindex: when anything tries to SET Humanoid.Health 
--    to a lower value, block it. 
-- 2. Hook __namecall: intercept TakeDamage calls directly. 
-- 3. Heartbeat: keep health at max as final fallback. 
-- ══════════════════════════════════════════════════════════ 
local godNewIndex = nil 
local godNC = nil 
local function StartGodmode() 
    -- Layer 1: __newindex hook — blocks Health writes to Humanoid 
    pcall(function() 
        if godNewIndex then return end 
        godNewIndex = hookmetamethod(game, "__newindex", function(self, key, value) 
            if godmodeEnabled and key == "Health" and self == GetHum() then 
                local hum = GetHum() 
                if hum and value < hum.MaxHealth then 
                    return godNewIndex(self, key, hum.MaxHealth) -- write max instead 
                end 
            end 
            return godNewIndex(self, key, value) 
        end) 
    end) 
    -- Layer 2: __namecall hook — intercepts TakeDamage 
    pcall(function() 
        if godNC then return end 
        godNC = hookmetamethod(game, "__namecall", function(self, ...) 
            local method = getnamecallmethod() 
            if godmodeEnabled and method == "TakeDamage" and self == GetHum() then 
                return -- swallow damage call 
            end 
            return godNC(self, ...) 
        end) 
    end) 
    -- Layer 3: Heartbeat fallback 
    DC("godmode") 
    connections.godmode = RunService.Heartbeat:Connect(function() 
        if not godmodeEnabled then return end 
        local hum = GetHum(); if not hum then return end 
        rawset(hum, "Health", hum.MaxHealth) -- rawset bypasses __newindex 
        -- Also set via property in case rawset doesn't work on this executor 
        pcall(function() hum.Health = hum.MaxHealth end) 
    end) 
end 

