-- ── Anti-Kick ─────────────────────────────────────────────────── 
-- Hooks __namecall to block Kick calls targeted at LocalPlayer. 
-- Also blocks client-side RemoteEvent "Kick" fires. 
local origNamecall = nil 
local kickBlocked = 0 
local function SetupAntiKick() 
    if origNamecall then return end -- already hooked 
    pcall(function() 
        origNamecall = hookmetamethod(game, "__namecall", function(self, ...) 
            local method = getnamecallmethod() 
            -- Block Kick on LocalPlayer 
            if method == "Kick" and self == LocalPlayer then 
                kickBlocked = kickBlocked + 1 
                Notify("Anti-Kick", "Kick attempt blocked! (" .. kickBlocked .. "x)", 4) 
                return -- do not call original 
            end 
            -- Block RemoteEvent fires that look like kick/ban events 
            if method == "FireServer" and self:IsA("RemoteEvent") then 
                local name = self.Name:lower() 
                if name:find("kick") or name:find("ban") or name:find("punish") then 
                    return -- block suspicious remote fires 
                end 
            end 
            return origNamecall(self, ...) 
        end) 
    end) 
end 

-- ── Anti-Detect (speed/teleport spoofing) ─────────────────────── 
-- Many games check CFrame delta per frame on the server. 
-- We smooth out our movement so it looks gradual, not teleport-like. 
-- Also spoofs WalkSpeed back to default between checks. 
local lastHRPPos = nil 
local spoofWS = false 
local function SetupAntiDetect() 
    -- Hook __index on Humanoid so if the server reads WalkSpeed it sees 16 
    -- (only works on games that do a client->server WalkSpeed read, uncommon) 
    pcall(function() 
        local origIndex = hookmetamethod(game, "__index", function(self, key) 
            if antiDetectEnabled and key == "WalkSpeed" and self == GetHum() then 
                return 16 -- lie to any reader 
            end 
            return origIndex(self, key) 
        end) 
    end) 
end 

-- ── Anti-Cheat Loop ───────────────────────────────────────────── 
