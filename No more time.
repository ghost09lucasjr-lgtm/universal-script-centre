DebugTab:CreateSection("Map Scanner") 
DebugTab:CreateButton({ Name="Scan Corruption Parts", Callback=function() local c=0 for _,v in ipairs(Workspace:GetDescendants()) do local n=v.Name:lower() if v:IsA("BasePart") and (n:find("corrupt") or n:find("wall") or n:find("death")) then print("[Corruption] "..v:GetFullName().." Size:"..tostring(v.Size)); c=c+1 end end Notify("Scan","Found "..c.." corruption-related parts. Check F9.",4) end }) 
DebugTab:CreateButton({ Name="Scan Exit Parts", Callback=function() local c=0 for _,v in ipairs(Workspace:GetDescendants()) do local n=v.Name:lower() if v:IsA("BasePart") and (n:find("exit") or n:find("goal") or n:find("finish") or n:find("portal")) then print("[Exit] "..v:GetFullName().." Pos:"..tostring(v.Position)); c=c+1 end end Notify("Scan","Found "..c.." exit-related parts. Check F9.",4) end }) 
DebugTab:CreateButton({ Name="Print My Position", Callback=function() local hrp=GetHRP(); if not hrp then return end local p=hrp.Position local msg=string.format("X:%.1f Y:%.1f Z:%.1f",p.X,p.Y,p.Z) print("[NMT Pos] "..msg); Notify("Position",msg,5) end }) 

