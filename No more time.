-- ======================== ANTI-CORRUPTION ======================== 
local lastSafePos = nil 
RunService.Heartbeat:Connect(function() 
    if not antiCorruptEnabled then return end 
    local hrp = GetHRP(); if not hrp then return end 
    if hrp.Position.Y > -20 then lastSafePos = hrp.CFrame end 
    local corruption = nil 
    local biggestSize = 0 
    for _, v in ipairs(Workspace:GetDescendants()) do 
        local n = v.Name:lower() 
        if v:IsA("BasePart") and (n:find("corrupt") or n:find("deathwall") or n:find("redwall")) then 
            local sz = v.Size.X * v.Size.Z 
            if sz > biggestSize then corruption = v; biggestSize = sz end 
        end 
    end 
    if corruption then 
        local diff = (hrp.Position - corruption.Position).Magnitude 
        if diff < corruptPushDist then 
            local wallFwd = corruption.CFrame.LookVector 
            hrp.CFrame = hrp.CFrame + wallFwd * (corruptPushDist - diff + 8) 
            Notify("Anti-Corruption", "Pushed ahead!", 2) 
        end 
    end 
end) 

